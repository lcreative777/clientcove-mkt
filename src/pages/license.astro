---
import Layout from '~/layouts/Layout.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/ui/Icon.astro';
import { CORE_LICENSES, FOUNDERS_LIFETIME, LAUNCH, CURRENT_TIERS } from '~/lib/site';

const UPDATED = 'July 28, 2026';

// Resale terms are stated per tier rather than inferred — only the tiers that
// explicitly carry white-label or resale rights are described as having them.
const RESALE: Record<string, string> = {
  single: '—',
  three: '—',
  developer: 'Client sites only — not for resale',
  agency: 'White-label & agency use',
};

const permitted = [
  'Install on infrastructure you own or rent, including a VPS, a private cloud, or your own hardware.',
  'Run the portal on your own domain, under your own branding, with your own colours and logo.',
  'Modify the code for your own use on a licensed site.',
  'Keep running the software indefinitely — the licence is perpetual and does not expire.',
  'Take full backups of your own database and files at any time. The data is yours.',
];

const notPermitted = [
  'Exceeding the site count your tier allows.',
  'Redistributing, reselling or sublicensing the software, except where your tier explicitly grants white-label or resale rights.',
  'Removing or altering licence-validation code.',
  'Publishing the source code, in whole or in part, in a public repository.',
];
---
<Layout
  title="License — What you get when you buy ClientCove"
  description="ClientCove is licensed, not rented. A plain summary of what each licence tier permits: site counts, white-label rights, perpetual use, and what the optional annual renewal covers."
>
  <PageHero
    eyebrow="LICENSE"
    title="Licensed, <em class='acc'>not rented.</em>"
    subtitle="You buy a licence once and keep it. This page summarises what each tier permits in plain language."
  />

  <section class="sect" style="padding-top:0;">
    <div class="container legal-wrap">
      <div class="legal-meta">
        <span><strong>Last updated</strong> {UPDATED}</span>
      </div>

      <div class="legal">
        <div class="callout">
          <p>
            <strong>The short version.</strong> A ClientCove licence is perpetual. You pay once, you
            install it on infrastructure you control, and it keeps working for as long as you want to
            run it. The optional annual renewal buys continued updates and support — not continued
            permission to use the software. Let it lapse and your install carries on running; you
            simply stop receiving new versions.
          </p>
        </div>

        <h2>What each tier permits</h2>
        <div class="table-wrap">
          <table class="lic-table">
            <thead>
              <tr><th>Tier</th><th>Sites</th><th>White-label / resale</th><th>Annual renewal</th></tr>
            </thead>
            <tbody>
              {CORE_LICENSES.map(l => (
                <tr>
                  <td><strong>{l.name}</strong></td>
                  <td>{l.sites}</td>
                  <td>{RESALE[l.id] ?? '—'}</td>
                  <td>${l.renewal}/yr</td>
                </tr>
              ))}
              {LAUNCH.active && (
                <tr>
                  <td><strong>{FOUNDERS_LIFETIME.name}</strong></td>
                  <td>{FOUNDERS_LIFETIME.sites}</td>
                  <td>White-label resale rights</td>
                  <td>None — lifetime Core updates</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
        <p class="note">
          Current pricing for each tier is on the <a href="/pricing">pricing page</a>. The renewal
          figure above is the ongoing annual cost of staying on the latest version; it is optional in
          every tier.
        </p>

        <h2>What the licence lets you do</h2>
        <ul>
          {permitted.map(p => <li>{p}</li>)}
        </ul>

        <h2>What it doesn't cover</h2>
        <ul>
          {notPermitted.map(p => <li>{p}</li>)}
        </ul>

        <h2>Updates and support</h2>
        <p>
          The annual renewal covers new releases, security patches and support for the period it
          runs. It is not a subscription to the software itself — the licence you already hold stays
          valid whether or not you renew. If you let a renewal lapse and later want to return to the
          latest version, you can start a new renewal term at any time.
        </p>

        <h2>Current is separate</h2>
        <p>
          <strong>Current</strong> — the {CURRENT_TIERS.map(t => t.name).join(', ')} services — is a
          recurring service subscription, not part of the perpetual licence. It provides
          infrastructure we operate on your behalf (transactional email, real-time updates, and the
          AI layer), so it is billed monthly or annually for as long as you use it. Cancelling
          Current does not affect your Core licence; the portal keeps running without it.
        </p>

        <h2>Your data</h2>
        <p>
          ClientCove is self-hosted. Your database lives on your infrastructure, and we have no
          access to it. Nothing in the licence gives us a claim over your data, your clients' data,
          or the content you put in the portal. How we handle the limited information we do hold is
          described in the <a href="/app/privacy-policy">privacy policy</a>.
        </p>

        <h2>The full agreement</h2>
        <div class="callout">
          <p>
            This page is a plain-language summary, written to be readable rather than exhaustive. It
            is not the complete licence agreement, and where the two differ the full agreement
            governs. The complete text is provided with your licence and is available on request
            before you buy — write to
            <a href="mailto:sales@clientcove.io">sales@clientcove.io</a> and we will send it.
          </p>
        </div>

        <h2>Questions</h2>
        <p>
          Licensing questions, volume arrangements, and anything about resale rights:
          <a href="mailto:sales@clientcove.io">sales@clientcove.io</a>.
        </p>
      </div>

      <div class="legal-cta">
        <a href="/pricing" class="btn btn-dark btn-lg">See pricing <Icon name="arrow" class="arrow" /></a>
        <a href="/contact" class="btn btn-ghost btn-lg">Ask a question</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-wrap { max-width: 820px; }

  .legal-meta {
    display: flex; gap: 10px; flex-wrap: wrap; align-items: center;
    font-size: 13.5px; color: var(--color-ink-3);
    padding-bottom: 22px; margin-bottom: 40px;
    border-bottom: 1px solid var(--color-line);
  }
  .legal-meta strong { color: var(--color-ink-2); font-weight: 600; }

  .legal { font-size: 16px; line-height: 1.7; color: var(--color-ink-2); }
  .legal h2 {
    font-family: var(--font-serif); font-weight: 600;
    font-size: 27px; line-height: 1.2; letter-spacing: -0.018em;
    color: var(--color-ink); margin: 52px 0 16px;
  }
  .legal p { margin: 0 0 16px; text-wrap: pretty; }
  .legal ul { margin: 0 0 16px; padding-left: 22px; }
  .legal li { margin-bottom: 10px; text-wrap: pretty; }
  .legal li::marker { color: var(--color-ink-4); }
  .legal strong { color: var(--color-ink); font-weight: 600; }
  .legal a { color: var(--color-orange-600); border-bottom: 1px solid rgba(231,111,42,.3); }
  .legal a:hover { border-bottom-color: var(--color-orange); }
  .legal .note {
    font-size: 14.5px; color: var(--color-ink-3);
    border-left: 2px solid var(--color-line);
    padding-left: 16px; margin-top: 18px;
  }

  .callout {
    background: var(--color-bg-2); border: 1px solid var(--color-line);
    border-radius: 12px; padding: 26px 28px; margin-bottom: 16px;
  }
  .callout > :last-child { margin-bottom: 0; }

  .table-wrap {
    overflow-x: auto; border: 1px solid var(--color-line);
    border-radius: 12px; margin-bottom: 16px;
  }
  .lic-table { width: 100%; border-collapse: collapse; min-width: 560px; }
  .lic-table th {
    text-align: left; font-size: 11px; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--color-ink-3); background: var(--color-bg-2);
    padding: 12px 16px; border-bottom: 1px solid var(--color-line); white-space: nowrap;
  }
  .lic-table td {
    padding: 15px 16px; font-size: 14.5px; line-height: 1.6;
    border-bottom: 1px solid var(--color-line-2); vertical-align: top;
  }
  .lic-table tbody tr:last-child td { border-bottom: 0; }

  .legal-cta {
    display: flex; gap: 10px; flex-wrap: wrap;
    margin-top: 56px; padding-top: 36px;
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 720px) {
    .legal { font-size: 15.5px; }
    .legal h2 { font-size: 24px; margin-top: 42px; }
  }
</style>

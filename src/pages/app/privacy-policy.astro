---
import Layout from '~/layouts/Layout.astro';
import PageHero from '~/components/PageHero.astro';
import { SITE } from '~/lib/site';

// Keep these two constants in sync with the OAuth consent screens.
// Reviewers compare the scope list here against the one they see in the
// Cloud Console — a mismatch is a common cause of a stalled verification.
const EFFECTIVE = 'July 28, 2026';
const UPDATED = 'July 28, 2026';

const PRIVACY_EMAIL = 'privacy@clientcove.io';

const mailScopes = [
  {
    scope: 'https://www.googleapis.com/auth/gmail.readonly',
    tier: 'Restricted',
    restricted: true,
    why:
      'Read the message headers, bodies and attachments needed to attach an email conversation to the contact or company it belongs to. Read-only: the connection cannot send, modify, label, archive or delete anything in the mailbox.',
  },
  {
    scope: 'openid',
    tier: 'Non-sensitive',
    why:
      'Returns the stable subject identifier (sub) for the Google Account. Mailboxes are keyed on this identifier rather than on the email address, so a renamed or re-aliased mailbox stays correctly linked. gmail.readonly does not return a stable identifier on its own.',
  },
  {
    scope: 'https://www.googleapis.com/auth/userinfo.email',
    tier: 'Non-sensitive',
    why:
      'Confirms which mailbox was connected, so the portal can show the operator exactly which address is syncing and warn them if they connect the wrong account.',
  },
];

const signInScopes = [
  {
    scope: 'openid',
    tier: 'Non-sensitive',
    why: 'Returns the stable subject identifier used to match a Google Account to an existing portal user.',
  },
  {
    scope: 'https://www.googleapis.com/auth/userinfo.email',
    tier: 'Non-sensitive',
    why: 'Provides the email address used to locate the matching portal account.',
  },
  {
    scope: 'https://www.googleapis.com/auth/userinfo.profile',
    tier: 'Non-sensitive',
    why: 'Provides the display name and profile picture used to populate the user profile.',
  },
];

const toc = [
  { id: 'summary', l: 'Summary' },
  { id: 'who-we-are', l: 'Who we are' },
  { id: 'roles', l: 'Roles: who controls what' },
  { id: 'google-data', l: 'Google user data' },
  { id: 'scopes', l: 'Scopes we request' },
  { id: 'data-flow', l: 'Where Google data goes' },
  { id: 'not-collected', l: 'What we do not collect' },
  { id: 'tokens', l: 'How tokens are handled' },
  { id: 'limited-use', l: 'Limited Use disclosure' },
  { id: 'retention', l: 'Retention and deletion' },
  { id: 'revoke', l: 'How to revoke access' },
  { id: 'other-data', l: 'Other information we collect' },
  { id: 'sharing', l: 'Sharing and sub-processors' },
  { id: 'security', l: 'Security' },
  { id: 'rights', l: 'Your rights' },
  { id: 'children', l: "Children's privacy" },
  { id: 'changes', l: 'Changes to this policy' },
  { id: 'contact', l: 'Contact' },
];

const policyLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy',
  url: `${SITE.url}/app/privacy-policy`,
  datePublished: '2026-07-28',
  dateModified: '2026-07-28',
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---
<Layout
  title="Privacy Policy"
  description="How ClientCove handles your data, including Google user data accessed through Google Sign-In and Gmail sync. Covers scopes requested, where data is stored, retention, and the Google API Services Limited Use requirements."
  jsonLd={policyLd}
>
  <PageHero
    eyebrow="LEGAL"
    title="Privacy <em class='acc'>Policy</em>"
    subtitle="How ClientCove handles your information — including the Google user data accessed through Google Sign-In and Gmail sync."
  />

  <section class="sect" style="padding-top:0;">
    <div class="container legal-wrap">
      <div class="legal-meta">
        <span><strong>Effective</strong> {EFFECTIVE}</span>
        <span class="sep">·</span>
        <span><strong>Last updated</strong> {UPDATED}</span>
      </div>

      <nav class="toc card" aria-label="Table of contents">
        <div class="toc-head">On this page</div>
        <ol>
          {toc.map(t => <li><a href={`#${t.id}`}>{t.l}</a></li>)}
        </ol>
      </nav>

      <div class="legal">
        <h2 id="summary">Summary</h2>
        <div class="callout">
          <p>
            This section is a plain-language summary. It is not a substitute for the full
            policy below, but nothing below contradicts it.
          </p>
          <ul>
            <li>
              <strong>Message content never reaches ClientCove's servers.</strong> ClientCove is
              self-hosted. The Gmail API is called from the customer's own installation, and mail
              is stored in the customer's own database.
            </li>
            <li>
              <strong>Only mail that already relates to a known business contact is stored.</strong>
              Messages whose counterparty does not match an existing contact or company in the
              portal — newsletters, personal correspondence, marketing — are discarded at capture
              and never written to disk.
            </li>
            <li>
              <strong>Gmail access is read-only.</strong> ClientCove cannot send, reply, modify,
              label, archive or delete anything in a connected mailbox.
            </li>
            <li>
              <strong>We do not retain OAuth tokens.</strong> Our licence server brokers the code
              exchange because Google requires a single fixed redirect URI, then hands the result
              to the customer's site and keeps nothing.
            </li>
            <li>
              <strong>Google user data is never used for advertising, and is never sold.</strong>
              See the <a href="#limited-use">Limited Use disclosure</a>.
            </li>
          </ul>
        </div>

        <h2 id="who-we-are">Who we are</h2>
        <p>
          ClientCove ("ClientCove", "we", "us") publishes client-portal software for service
          businesses. The software is licensed and self-hosted: customers run it on infrastructure
          they own and control. This policy is published at
          <code>https://clientcove.io/app/privacy-policy</code> and is the single privacy policy
          for ClientCove and for the Google applications described below. There is not a separate
          policy per installation.
        </p>
        <p>
          Privacy questions and requests: <a href={`mailto:${PRIVACY_EMAIL}`}>{PRIVACY_EMAIL}</a>.
        </p>

        <h2 id="roles">Roles: who controls what</h2>
        <p>
          Because ClientCove is self-hosted, the usual SaaS description of data handling would be
          inaccurate, and the distinction matters for understanding the rest of this policy:
        </p>
        <ul>
          <li>
            <strong>The customer</strong> — the business running a ClientCove installation — is the
            controller of the data in that installation, including any email synced into it. They
            choose which mailboxes to connect, and they can delete the contents at any time.
          </li>
          <li>
            <strong>ClientCove</strong> is the software vendor. We publish the code and operate the
            OAuth broker described below. We do not receive, store or have access to the contents of
            a customer's database or their synced mail.
          </li>
        </ul>
        <p>
          Where this policy says "we do not store" something, it means exactly that: the data is not
          transmitted to infrastructure ClientCove operates.
        </p>

        <h2 id="google-data">Google user data</h2>
        <p>
          ClientCove operates two separate Google applications. They request different scopes, serve
          different purposes, and are described separately throughout this policy.
        </p>
        <ul>
          <li>
            <strong>ClientCove Mail Sync</strong> — connects a Gmail mailbox so that email
            correspondence with a contact appears on that contact's record inside the portal. This
            application requests a restricted scope.
          </li>
          <li>
            <strong>ClientCove Sign-In</strong> — lets a user sign in to a ClientCove portal with
            their Google Account. This application does not request any mail scope and never has
            access to mail.
          </li>
        </ul>
        <p>
          Connecting either is optional and user-initiated. A ClientCove portal is fully functional
          without any Google connection.
        </p>

        <h2 id="scopes">Scopes we request</h2>

        <h3>ClientCove Mail Sync</h3>
        <div class="table-wrap">
          <table class="scope-table">
            <thead>
              <tr><th>Scope</th><th>Tier</th><th>Why it is requested</th></tr>
            </thead>
            <tbody>
              {mailScopes.map(s => (
                <tr>
                  <td><code>{s.scope}</code></td>
                  <td><span class={`tier${s.restricted ? ' tier-restricted' : ''}`}>{s.tier}</span></td>
                  <td>{s.why}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          <code>gmail.readonly</code> is the narrowest scope that returns message bodies and
          attachments. Narrower alternatives were considered and rejected:
          <code>gmail.metadata</code> returns headers only, which cannot show the correspondence
          itself; <code>gmail.modify</code> and <code>gmail.send</code> grant write access the
          feature does not need and are therefore not requested.
        </p>

        <h3>ClientCove Sign-In</h3>
        <div class="table-wrap">
          <table class="scope-table">
            <thead>
              <tr><th>Scope</th><th>Tier</th><th>Why it is requested</th></tr>
            </thead>
            <tbody>
              {signInScopes.map(s => (
                <tr>
                  <td><code>{s.scope}</code></td>
                  <td><span class="tier">{s.tier}</span></td>
                  <td>{s.why}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          Sign-In requests no sensitive or restricted scopes and has no access to Gmail, Drive,
          Calendar, Contacts or any other Google service.
        </p>

        <h2 id="data-flow">Where Google data goes</h2>
        <p>
          A customer connects a mailbox from <em>Settings → Connected Accounts</em> in their own
          portal. There are no credentials to copy, paste or configure. What happens after they
          approve the Google consent screen:
        </p>
        <ol class="flow">
          <li>
            Google redirects to <code>account.clientcove.io</code>, our licence server. It exists in
            this flow for one reason: Google requires a single fixed redirect URI, and every
            customer installation lives on a different domain.
          </li>
          <li>
            The licence server exchanges the authorization code for tokens and hands the result
            directly to the customer's installation. <strong>It retains no tokens.</strong> This is
            a deliberate design constraint — a single database holding tokens for every customer's
            mailbox would be a far more damaging thing to lose than a licence table, so it does not
            exist.
          </li>
          <li>
            From that point on, <strong>all Gmail API calls are made by the customer's own
            installation, directly to Google.</strong> Message content does not travel through
            ClientCove infrastructure.
          </li>
          <li>
            Matched messages are written to the customer's own database. Attachments are written to
            an S3-compatible object storage bucket that the customer owns and controls.
          </li>
        </ol>
        <p>
          The practical consequence: ClientCove holds no copy of any customer's mail, and could not
          produce one if asked.
        </p>

        <h2 id="not-collected">What we do not collect</h2>
        <p>
          Mail sync is filtered at capture, not after storage. A message is stored only if its
          counterparty — the sender or recipient on the other side of the conversation — already
          corresponds to a contact or company record in the portal. Everything else is evaluated in
          memory and discarded without being written to disk. In practice this means newsletters,
          notifications, marketing mail, and personal correspondence with people who are not
          business contacts are never stored at all.
        </p>
        <p>We also do not:</p>
        <ul>
          <li>Use Google user data to train machine-learning or AI models, whether ours or a third party's.</li>
          <li>Build advertising profiles or audience segments from Google user data.</li>
          <li>Transfer Google user data to data brokers, information resellers, or advertising platforms.</li>
          <li>Access Gmail data for any purpose other than the mail-sync feature described above.</li>
        </ul>

        <h2 id="tokens">How tokens are handled</h2>
        <ul>
          <li>
            Access and refresh tokens are stored only on the customer's own installation, encrypted
            at rest with AES-256-GCM.
          </li>
          <li>
            The OAuth client secret exists only on ClientCove's licence server. It is never
            distributed to installations, and there are no per-customer credentials to manage.
          </li>
          <li>
            The licence server does not persist tokens at any point. It exchanges the code and
            forwards the result.
          </li>
          <li>
            Pressing <em>Disconnect</em> in the portal destroys the stored token immediately and
            stops all further Gmail API calls.
          </li>
        </ul>

        <h2 id="limited-use">Limited Use disclosure</h2>
        <div class="callout callout-strong">
          <p>
            ClientCove's use and transfer of information received from Google APIs to any other app
            will adhere to the
            <a href="https://developers.google.com/terms/api-services-user-data-policy" rel="noopener noreferrer" target="_blank">Google API Services User Data Policy</a>,
            including the Limited Use requirements.
          </p>
        </div>
        <p>Specifically, and without limiting the statement above:</p>
        <ul>
          <li>
            We limit our use of Google user data to providing and improving the user-facing mail-sync
            and sign-in features described in this policy, both of which are prominent in the
            portal's interface.
          </li>
          <li>
            We do not transfer or sell Google user data to third parties such as advertising
            platforms, data brokers or information resellers.
          </li>
          <li>
            We do not use or transfer Google user data for serving advertisements, including
            retargeting, personalized or interest-based advertising.
          </li>
          <li>
            We do not allow humans to read Google user data, except: with the user's affirmative
            agreement for specific messages; where necessary for security purposes such as
            investigating abuse; to comply with applicable law; or where the data has been
            aggregated and anonymized for internal operations. In the ordinary course this does not
            arise, because Gmail message content is never transmitted to ClientCove.
          </li>
        </ul>

        <h2 id="retention">Retention and deletion</h2>
        <div class="table-wrap">
          <table class="scope-table">
            <thead>
              <tr><th>Data</th><th>Where it lives</th><th>Retention</th></tr>
            </thead>
            <tbody>
              <tr>
                <td>OAuth access &amp; refresh tokens</td>
                <td>Customer's installation, AES-256-GCM encrypted</td>
                <td>Destroyed immediately on <em>Disconnect</em> or on revocation from the Google Account</td>
              </tr>
              <tr>
                <td>Matched message content &amp; attachments</td>
                <td>Customer's own database and object storage</td>
                <td>Kept until the customer deletes them; deletable at any time from the portal</td>
              </tr>
              <tr>
                <td>Unmatched messages</td>
                <td>Nowhere — evaluated in memory</td>
                <td>Never written to disk</td>
              </tr>
              <tr>
                <td>Google subject identifier, email, profile name/picture (Sign-In)</td>
                <td>Customer's installation</td>
                <td>Kept while the portal account exists; removed when the account is deleted</td>
              </tr>
              <tr>
                <td>OAuth tokens on ClientCove's licence server</td>
                <td>Not stored</td>
                <td>Not applicable — never retained</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Because synced mail lives only in the customer's installation, deletion is performed by the
          customer, who controls that system. ClientCove cannot delete it on their behalf, and holds
          no copy that would need deleting. Requests about data in a specific portal should go to the
          business operating that portal.
        </p>

        <h2 id="revoke">How to revoke access</h2>
        <p>Either method takes effect immediately, and both are available at any time:</p>
        <ul>
          <li>
            <strong>In the portal</strong> — <em>Settings → Connected Accounts → Disconnect</em>.
            This destroys the stored token and stops all Gmail API access.
          </li>
          <li>
            <strong>From your Google Account</strong> —
            <a href="https://myaccount.google.com/permissions" rel="noopener noreferrer" target="_blank">myaccount.google.com/permissions</a>,
            then remove access for the ClientCove application. This invalidates the token from
            Google's side regardless of the state of any installation.
          </li>
        </ul>

        <h2 id="other-data">Other information we collect</h2>
        <p>
          Outside the Google integrations, ClientCove collects a deliberately small amount of
          information:
        </p>
        <ul>
          <li>
            <strong>This website (clientcove.io).</strong> We run no analytics, no advertising
            tags, and no third-party tracking scripts. We set no tracking cookies.
          </li>
          <li>
            <strong>Contact form.</strong> If you send us a message, we receive the name, email,
            company and message you submit, and use them only to reply.
          </li>
          <li>
            <strong>Licence and account records.</strong> If you buy a licence, we hold the
            purchaser's name, email, billing details as required to issue and validate the licence,
            and the domains a licence is activated on. Payment card details are handled by our
            payment processor and are not stored by us.
          </li>
          <li>
            <strong>Server logs.</strong> Our own servers keep standard operational logs (IP address,
            timestamp, requested URL) for security and troubleshooting, retained for a limited period.
          </li>
        </ul>
        <p>
          Data inside a customer's ClientCove portal — their clients, projects, invoices, files and
          synced mail — is not collected by us at all. It is on their infrastructure.
        </p>

        <h2 id="sharing">Sharing and sub-processors</h2>
        <p>
          We do not sell personal information, and we do not share it for cross-context behavioural
          advertising. We share the limited information described above only with service providers
          that make our own operations possible — payment processing, transactional email for licence
          delivery, and hosting for clientcove.io and the licence server — and only to the extent
          needed to perform those functions. We also disclose information where required by law.
        </p>
        <p>
          <strong>No Google user data is shared with any of these providers</strong>, because none of
          it reaches our infrastructure in the first place.
        </p>

        <h2 id="security">Security</h2>
        <ul>
          <li>All traffic to clientcove.io and account.clientcove.io is encrypted in transit (TLS).</li>
          <li>OAuth refresh tokens are encrypted at rest with AES-256-GCM on the customer's installation.</li>
          <li>
            The OAuth client secret is held only on the licence server. No secret material is
            distributed to installations.
          </li>
          <li>
            Token retention is minimised by design: the broker holds nothing, so there is no central
            store of mailbox credentials to compromise.
          </li>
          <li>
            Self-hosted installations are secured by the customer. We publish hardening guidance in
            our documentation, but we cannot control the security of infrastructure we do not operate.
          </li>
        </ul>
        <p>
          No system is perfectly secure. If you believe you have found a vulnerability, please write
          to <a href={`mailto:${PRIVACY_EMAIL}`}>{PRIVACY_EMAIL}</a>.
        </p>

        <h2 id="rights">Your rights</h2>
        <p>
          Depending on where you live, you may have rights to access, correct, delete, or export
          personal information we hold about you, to object to or restrict certain processing, and to
          withdraw consent. To exercise them, write to
          <a href={`mailto:${PRIVACY_EMAIL}`}>{PRIVACY_EMAIL}</a>. We will not discriminate against
          you for exercising them.
        </p>
        <p>
          For Google data: because we never receive it, the fastest route is the
          <a href="#revoke">revocation options above</a>, plus a request to the business operating
          the portal for anything already stored there.
        </p>

        <h2 id="children">Children's privacy</h2>
        <p>
          ClientCove is business software and is not directed to children. We do not knowingly
          collect personal information from anyone under 16. If you believe a child has provided us
          information, contact us and we will delete it.
        </p>

        <h2 id="changes">Changes to this policy</h2>
        <p>
          If we change how Google user data is accessed, used, stored or shared — including any change
          to the scopes listed above — we will update this page and the "last updated" date before the
          change takes effect. Material changes affecting existing connections will also be
          communicated in-product.
        </p>

        <h2 id="contact">Contact</h2>
        <p>
          ClientCove<br />
          Privacy: <a href={`mailto:${PRIVACY_EMAIL}`}>{PRIVACY_EMAIL}</a><br />
          General: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-wrap { max-width: 820px; }

  .legal-meta {
    display: flex; gap: 10px; flex-wrap: wrap; align-items: center;
    font-size: 13.5px; color: var(--color-ink-3);
    padding-bottom: 22px; border-bottom: 1px solid var(--color-line);
  }
  .legal-meta strong { color: var(--color-ink-2); font-weight: 600; }
  .legal-meta .sep { color: var(--color-ink-4); }

  .toc { padding: 24px 28px; margin: 32px 0 48px; background: var(--color-bg-2); }
  .toc-head {
    font-size: 11px; font-weight: 600; letter-spacing: .16em;
    text-transform: uppercase; color: var(--color-ink-3); margin-bottom: 14px;
  }
  .toc ol {
    margin: 0; padding: 0; list-style: none;
    columns: 2; column-gap: 32px;
  }
  .toc li { font-size: 14px; line-height: 1.5; margin-bottom: 8px; break-inside: avoid; }
  .toc a { color: var(--color-ink-2); border-bottom: 1px solid transparent; }
  .toc a:hover { color: var(--color-orange); border-bottom-color: currentColor; }

  /* ── Legal prose ─────────────────────────────────────────────── */
  .legal { font-size: 16px; line-height: 1.7; color: var(--color-ink-2); }

  .legal h2 {
    font-family: var(--font-serif); font-weight: 600;
    font-size: 27px; line-height: 1.2; letter-spacing: -0.018em;
    color: var(--color-ink);
    margin: 56px 0 16px; scroll-margin-top: 90px;
  }
  .legal h2:first-child { margin-top: 0; }
  .legal h3 {
    font-family: var(--font-sans); font-weight: 650;
    font-size: 16.5px; letter-spacing: -0.005em;
    color: var(--color-ink);
    margin: 34px 0 14px; scroll-margin-top: 90px;
  }

  .legal p { margin: 0 0 16px; text-wrap: pretty; }
  .legal ul, .legal ol { margin: 0 0 16px; padding-left: 22px; }
  .legal li { margin-bottom: 10px; text-wrap: pretty; }
  .legal li::marker { color: var(--color-ink-4); }
  .legal strong { color: var(--color-ink); font-weight: 600; }

  .legal a {
    color: var(--color-orange-600);
    border-bottom: 1px solid rgba(231, 111, 42, .3);
  }
  .legal a:hover { border-bottom-color: var(--color-orange); }

  .legal code {
    font-family: var(--font-mono); font-size: .86em;
    background: var(--color-navy-50); color: var(--color-ink);
    padding: 2px 6px; border-radius: 5px;
    overflow-wrap: anywhere;
  }

  .legal .note {
    font-size: 14.5px; color: var(--color-ink-3);
    border-left: 2px solid var(--color-line);
    padding-left: 16px; margin-top: 18px;
  }

  /* ── Callouts ────────────────────────────────────────────────── */
  .callout {
    background: var(--color-bg-2);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 26px 28px;
    margin-bottom: 16px;
  }
  .callout > :last-child { margin-bottom: 0; }
  .callout ul { margin-bottom: 0; }

  .callout-strong {
    background: var(--color-orange-50);
    border-color: rgba(231, 111, 42, .28);
  }
  .callout-strong p { font-size: 16.5px; color: var(--color-ink); margin: 0; }

  /* ── Ordered flow list ───────────────────────────────────────── */
  .flow { counter-reset: flow; list-style: none; padding-left: 0; }
  .flow li {
    counter-increment: flow;
    position: relative; padding-left: 40px; margin-bottom: 16px;
  }
  .flow li::before {
    content: counter(flow);
    position: absolute; left: 0; top: 1px;
    width: 26px; height: 26px; border-radius: 999px;
    display: grid; place-items: center;
    background: var(--color-navy-900); color: #fff;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
  }

  /* ── Scope tables ────────────────────────────────────────────── */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    margin-bottom: 16px;
  }
  .scope-table { width: 100%; border-collapse: collapse; min-width: 560px; }
  .scope-table th {
    text-align: left; font-size: 11px; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--color-ink-3); background: var(--color-bg-2);
    padding: 12px 16px; border-bottom: 1px solid var(--color-line);
    white-space: nowrap;
  }
  .scope-table td {
    padding: 15px 16px; font-size: 14.5px; line-height: 1.6;
    border-bottom: 1px solid var(--color-line-2);
    vertical-align: top;
